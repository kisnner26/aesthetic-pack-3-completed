[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",0x00020000,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%cross%,%10%\%CUR_DIR%\%text%,%10%\%CUR_DIR%\%hand%,%10%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%vert%,%10%\%CUR_DIR%\%horz%,%10%\%CUR_DIR%\%dgn1%,%10%\%CUR_DIR%\%dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%pin%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
"Aesthetic normal select.cur"
"Aesthetic help select.ani"
"Aesthetic working n background.ani"
"Aesthetic busy.ani"
"Aesthetic precision select.cur"
"Aesthetic text select.ani"
"Aesthetic Handwriting.cur"
"Aesthetic unvailable select.ani"
"Aesthetic vertical resize.cur"
"Aesthetic horizontal resize.cur"
"Aesthetic diagonal resize 1.cur"
"Aesthetic diagonal resize 2.cur"
"Aesthetic move.cur"
"Aesthetic alternate select.cur"
"Aesthetic Link Select.cur"
"Aesthetic location select.cur"
"Aesthetic person select.cur"

[Scheme.Txt]
readme.txt

[Strings]
CUR_DIR       = "Cursors\Aesthetic pack 3"
SCHEME_NAME   = "Aesthetic pack 3"
pointer     = "Aesthetic normal select.cur"
help        = "Aesthetic help select.ani"
work        = "Aesthetic working n background.ani"
busy        = "Aesthetic busy.ani"
cross       = "Aesthetic precision select.cur"
text        = "Aesthetic text select.ani"
hand        = "Aesthetic Handwriting.cur"
unavailable = "Aesthetic unvailable select.ani"
vert        = "Aesthetic vertical resize.cur"
horz        = "Aesthetic horizontal resize.cur"
dgn1        = "Aesthetic diagonal resize 1.cur"
dgn2        = "Aesthetic diagonal resize 2.cur"
move        = "Aesthetic move.cur"
alternate   = "Aesthetic alternate select.cur"
link        = "Aesthetic Link Select.cur"
pin         = "Aesthetic location select.cur"
person      = "Aesthetic person select.cur"
